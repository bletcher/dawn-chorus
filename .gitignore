# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv*/        # .venv, and malformed variants like .venv.venv/
venv/
env/
.pytest_cache/

# Data & generated artifacts (don't commit station DBs or outputs)
*.db
*.sqlite
*_weather.csv
results*/

# Raw audio recordings — huge, belong in cold storage, never in git
*.wav
*.flac

# Local processing state (machine-specific mtimes)
manifest.json

# Local click-to-listen dashboard (needs the recordings; the public site is site/index.html)
site/dashboard-local.html

# Keep the example config despite the csv rule above
!config.example.yaml

# OS / editor
.DS_Store
.vscode/
.idea/
