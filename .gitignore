# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
# NB: gitignore has no trailing comments -- a '#' mid-line is part of the pattern, not a
# comment. `.venv*/  # note` therefore matched nothing and let ~10k venv files into
# `git status`. Keep comments on their own line.
.venv*/
venv/
env/
.pytest_cache/

# Data & generated artifacts (don't commit station DBs or outputs)
*.db
*.sqlite
*_weather.csv
results*/

# Raw audio recordings — huge, belong in cold storage, never in git
*.wav
*.flac

# Local processing state (machine-specific mtimes)
manifest.json

# Recorder-comparison reports (regenerate with `run.ps1 compare`)
compare/

# Local click-to-listen dashboards (need the recordings; the public site is site/index.html).
# Glob, not one name: there is one dashboard per recorder when a site runs more than one.
site/dashboard-*.html

# In-browser BirdNET spike (large model + WASM; experimental)
_bnet_spike/

# Desktop app: bundled models (large, fetched from birdnet-analyzer) + build output
desktop/models/
desktop/build/
desktop/dist/
dawn-chorus-output/

# Keep the example config despite the csv rule above
!config.example.yaml

# OS / editor
.DS_Store
.vscode/
.idea/
